####################################
# Node / JS (everywhere)
####################################
**/node_modules/**
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/*.log

####################################
# Environment variables (everywhere)
####################################
**/.env
**/.env.*
!**/.env.example

####################################
# Build outputs (everywhere)
####################################
**/dist/**
**/build/**
**/out/**
**/.next/**
**/.vite/**

####################################
# Cache / Temp (everywhere)
####################################
**/.cache/**
**/.tmp/**
**/temp/**
**/.eslintcache

####################################
# Coverage / Test
####################################
**/coverage/**
**/.nyc_output/**

####################################
# Database / Dumps
####################################
**/*.db
**/*.sqlite
**/data/**
**/mongo-data/**
**/dump/**

####################################
# Logs
####################################
**/logs/**
**/*.log

####################################
# OS junk (everywhere)
####################################
**/.DS_Store
**/Thumbs.db
**/desktop.ini

####################################
# IDE / Editor (everywhere)
####################################
**/.vscode/**
**/.idea/**
**/*.swp
**/*.swo
**/*.bak
**/*.tmp

####################################
# Docker
####################################
**/.dockerignore
**/docker-compose.override.yml

####################################
# Secrets / Certificates
####################################
**/*.pem
**/*.key
**/*.crt
**/*.p12

####################################
# Archives
####################################
**/*.zip
**/*.tar
**/*.tgz
**/*.rar
